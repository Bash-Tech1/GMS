<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gym.controller.member.MyStatisticsController">
    <top>
        <HBox styleClass="dashboard-header" alignment="CENTER_LEFT" spacing="15">
            <Button text="← Back" onAction="#handleBack" styleClass="action-button" style="-fx-background-color: #95A5A6;"/>
            <Label text="📊 My Statistics" styleClass="dashboard-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="20" styleClass="dashboard-content">
            <HBox spacing="20">
                <VBox styleClass="action-card" style="-fx-padding: 20px;">
                    <Label text="Total Classes Attended" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3498DB;"/>
                    <Label fx:id="classesAttendedLabel" text="0" style="-fx-font-size: 32px;"/>
                </VBox>
                <VBox styleClass="action-card" style="-fx-padding: 20px;">
                    <Label text="Active Workout Plans" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27AE60;"/>
                    <Label fx:id="workoutPlansLabel" text="0" style="-fx-font-size: 32px;"/>
                </VBox>
                <VBox styleClass="action-card" style="-fx-padding: 20px;">
                    <Label text="Total Bookings" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;"/>
                    <Label fx:id="totalBookingsLabel" text="0" style="-fx-font-size: 32px;"/>
                </VBox>
            </HBox>
            <VBox spacing="10" styleClass="action-card">
                <Label text="Recent Activity" styleClass="section-title"/>
                <Label fx:id="recentActivityLabel" wrapText="true" style="-fx-font-size: 14px;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>

