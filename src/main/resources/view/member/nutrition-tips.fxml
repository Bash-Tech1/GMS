<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gym.controller.member.NutritionTipsController">
    <top>
        <HBox styleClass="dashboard-header" alignment="CENTER_LEFT" spacing="15">
            <Button text="← Back" onAction="#handleBack" styleClass="action-button" style="-fx-background-color: #95A5A6;"/>
            <Label text="🥗 Nutrition Tips" styleClass="dashboard-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="20" styleClass="dashboard-content">
            <VBox spacing="15" styleClass="action-card">
                <Label text="General Nutrition Tips" styleClass="section-title"/>
                <TextArea fx:id="tipsArea" editable="false" wrapText="true" 
                          style="-fx-font-size: 14px;" prefRowCount="20"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>

